<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal -->
    <style name="Theme.AsaderoLa75" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Colores principales -->
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryContainer">#1A2238</item>
        <item name="colorSecondary">#22C55E</item>

        <!-- Fondo -->
        <item name="android:windowBackground">#0B1120</item>

        <!-- Barra de estado -->
        <item name="android:statusBarColor">#0B1120</item>

        <!-- Barra de navegación -->
        <item name="android:navigationBarColor">#0B1120</item>

        <!-- Texto -->
        <item name="android:textColor">#FFFFFF</item>

    </style>

    <!-- Diálogos -->

    <style name="DialogOscuro" parent="Theme.Material3.Dark.Dialog.Alert">

        <item name="android:background">#1A2238</item>

        <item name="android:textColor">#FFFFFF</item>

        <item name="colorPrimary">#3B82F6</item>

    </style>

    <!-- Spinner -->

    <style name="SpinnerOscuro" parent="Widget.AppCompat.Spinner">

        <item name="android:background">#1A2238</item>

        <item name="android:textColor">#FFFFFF</item>

    </style>

    <style name="Base.Theme.AsaderoLa75"
        parent="Theme.Material3.Dark.NoActionBar"/>

</resources>