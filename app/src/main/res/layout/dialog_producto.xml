<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción (opcional)"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock actual"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidad de medida"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPrecioCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio compra (opcional)"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPrecioVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio venta (opcional)"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/carbon3"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerTipo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/carbon3"
            android:popupBackground="@color/white"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/carbon3"
            android:popupBackground="@color/white"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>

</ScrollView>